{
  "name": "craftcms/contact-form-honeypot",
  "description": "Add a honeypot captcha to your Craft CMS contact form",
  "type": "craft-plugin",
  "keywords": [
    "cms",
    "craftcms",
    "contact",
    "form",
    "honeypot"
  ],
  "license": "MIT",
  "authors": [
    {
      "name": "Pixel & Tonic",
      "homepage": "https://pixelandtonic.com/"
    }
  ],
  "support": {
    "email": "support@craftcms.com",
    "issues": "https://github.com/craftcms/contact-form-honeypot/issues?state=open",
    "source": "https://github.com/craftcms/contact-form-honeypot",
    "docs": "https://github.com/craftcms/contact-form-honeypot/blob/3.x/README.md",
    "rss": "https://github.com/craftcms/contact-form-honeypot/commits/3.x.atom"
  },
  "minimum-stability": "dev",
  "prefer-stable": true,
  "require": {
    "php": "^8.5",
    "craftcms/cms": "^6.0.0",
    "craftcms/contact-form": "^4.0"
  },
  "require-dev": {
    "larastan/larastan": "^3.13",
    "laravel/pint": "^1.22",
    "orchestra/testbench": "^11.0",
    "phpstan/phpstan": "^2.1"
  },
  "autoload": {
    "psr-4": {
      "CraftCms\\ContactForm\\Honeypot\\": "src/"
    }
  },
  "scripts": {
    "check-cs": "pint --test",
    "fix-cs": "pint",
    "phpstan": "phpstan --memory-limit=1G"
  },
  "extra": {
    "name": "Contact Form Honeypot",
    "handle": "contact-form-honeypot",
    "documentationUrl": "https://github.com/craftcms/contact-form-honeypot/blob/3.x/README.md"
  },
  "config": {
    "platform": {
      "php": "8.5"
    },
    "allow-plugins": {
      "craftcms/plugin-installer": true
    }
  }
}
